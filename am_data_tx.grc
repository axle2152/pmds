- name: epy_block_cquam
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nC-QUAM AM stereo modulator (Motorola Compatible Quadrature\
      \ AM), complex baseband.\nWith stereo off, the same block is a plain AM modulator:\
      \ (L+R) on the envelope,\nno phase modulation, no pilot.\n\nInputs : L and R\
      \ audio (float), band-limited beforehand.\nOutput : complex baseband, carrier\
      \ = 1.0 (scale for transmit power afterwards).\n\nFollows 47 CFR 73.128: L+R\
      \ = 1 is 100% amplitude modulation, L-R = 1 is 100%\nphase modulation (45 degrees\
      \ with no envelope modulation), and a 25 Hz pilot\nat +/-0.05 rad (5% L-R) signals\
      \ stereo. Unlike plain QUAM, the envelope is\nheld at exactly 1 + (L+R), so\
      \ mono radios and C-QUAM decoders both hear clean\naudio; only the phase carries\
      \ the stereo difference.\n\nlevel    : scale for each channel; 0.5 makes full-scale\
      \ L = R = 1.0 equal 100%.\n           Stereo Tool's asymmetry turns its output\
      \ down to make room for +125%:\n           with +125% at full scale, -100% lands\
      \ at 0.8, so level = 0.5 / 0.8 = 0.625.\n           Calibrate with the monitor:\
      \ negative peaks at 95-100% on dense program.\nstereo   : 1 = C-QUAM stereo,\
      \ 0 = mono AM (L+R only)\npilot    : 25 Hz pilot, as a fraction of 100% L-R\
      \ (0.05 = the FCC's 5%)\npos_peak : positive modulation limit (1.25 = +125%);\
      \ negative is held at -100%\n\"\"\"\nimport numpy as np\nfrom gnuradio import\
      \ gr\n\n\nclass blk(gr.sync_block):\n    def __init__(self, samp_rate=192000,\
      \ level=0.5, pilot=0.05, pos_peak=1.25, stereo=1):\n        gr.sync_block.__init__(self,\
      \ name='C-QUAM Modulator',\n                               in_sig=[np.float32,\
      \ np.float32], out_sig=[np.complex64])\n        self.samp_rate = samp_rate\n\
      \        self.level = level\n        self.pilot = pilot\n        self.pos_peak\
      \ = pos_peak\n        self.stereo = stereo\n        self._n = 0\n\n    def work(self,\
      \ input_items, output_items):\n        L = input_items[0].astype(np.float64)\
      \ * self.level\n        R = input_items[1].astype(np.float64) * self.level\n\
      \        n = len(L)\n        period = int(round(self.samp_rate / 25.0))    \
      \        # 7680 samples at 192 kHz\n        k = (self._n + np.arange(n)) % period\
      \                 # pilot phase, continuous across calls\n        self._n =\
      \ (self._n + n) % period\n        s = L + R\n        if self.stereo:\n     \
      \       d = L - R + self.pilot * np.cos(2 * np.pi * k / period)\n        else:\n\
      \            d = np.zeros(n)                                   # mono AM: the\
      \ envelope only\n        env = np.clip(1.0 + s, 0.0, 1.0 + self.pos_peak)  \
      \    # -100% .. +125%\n        theta = np.arctan2(d, 1.0 + s)              \
      \          # QUAM's phase ...\n        output_items[0][:] = (env * np.exp(1j\
      \ * theta)).astype(np.complex64)   # ... C-QUAM's envelope\n        return n\n"
    affinity: ''
    alias: ''
    comment: ''
    level: mod_level
    maxoutbuf: '0'
    minoutbuf: '0'
    pilot: pilot_level
    pos_peak: '1.25'
    samp_rate: samp_rate
    stereo: stereo
  states:
    _io_cache: ('C-QUAM Modulator', 'blk', [('samp_rate', '192000'), ('level', '0.5'),
      ('pilot', '0.05'), ('pos_peak', '1.25'), ('stereo', '1')], [('0', 'float', 1),
      ('1', 'float', 1)], [('0', 'complex', 1)], '', ['level', 'pilot', 'pos_peak',
      'samp_rate', 'stereo'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 140]
    rotation: 0
    state: enabled
- name: epy_block_pmds
  id: epy_block
  parameters:
    _source_code: "# Copyright 2026 Michael Foley\n# SPDX-License-Identifier: GPL-3.0-or-later\n\
      #\n# This program is free software: you can redistribute it and/or modify it\
      \ under the terms of\n# the GNU General Public License as published by the Free\
      \ Software Foundation, either version 3\n# of the License, or (at your option)\
      \ any later version.\n#\n# This program is distributed in the hope that it will\
      \ be useful, but WITHOUT ANY WARRANTY;\n# without even the implied warranty\
      \ of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.\n# See the GNU General\
      \ Public License for more details: <https://www.gnu.org/licenses/>.\n\"\"\"\n\
      PMDS encoder block for GNU Radio: a thin wrapper around pmds.Encoder.\n\nInput\
      \  : complex baseband from the AM modulator (mono AM: a real, positive envelope).\n\
      Output : the same signal with the data added as slow phase modulation, y = x\
      \ * e^(j*theta).\n         The envelope is untouched, so envelope detectors\
      \ see nothing.\n\nThe parameters, the group schedule and the text sources are\
      \ described in pmds.encoder.\nThe sample rate has to be a whole multiple of the\
      \ bit rate: 192000, 96000 or 48000. At any\nother rate the bit rate comes out\
      \ wrong, and this block prints a warning.\nThe pmds package has to be importable: install\
      \ it once from the radioconda prompt with\n    pip install -e <the folder that\
      \ holds pmds>\nor keep the pmds folder beside the flowgraph and start GNU Radio\
      \ Companion from there.\n\"\"\"\nimport os\nimport sys\n\nimport numpy as np\n\
      from gnuradio import gr\n\ntry:\n    from pmds.encoder import Encoder\nexcept\
      \ ImportError:                                  # not installed: look in the\
      \ working folder\n    sys.path.insert(0, os.getcwd())\n    try:\n        from\
      \ pmds.encoder import Encoder\n    except ImportError:\n        raise ImportError('PMDS:\
      \ the pmds package was not found. Install it once with '\n                 \
      \         '\"pip install -e <folder that holds pmds>\", or start GNU Radio '\n\
      \                          'Companion from that folder.') from None\n\n\nclass\
      \ blk(Encoder, gr.sync_block):\n    \"\"\"PMDS encoder: RDS-style station data\
      \ on the carrier's phase. Parameters and text\n    sources are described in\
      \ pmds.encoder.\"\"\"\n\n    strict_rate = False       # a sample rate the bit\
      \ rate doesn't divide: warn, don't stop\n\n    def __init__(self, samp_rate=192000, data_on=1,\
      \ deviation=8.6, bit_rate=93.75, fmt='compact',\n                 call='WAMD',\
      \ pi='', pty=4, tp=0, ta=0, ps='AM 1710', ps_upper=1, ps_file='',\n        \
      \         rt='', rt_file='C:/RadioDJv2/Now_Playing.txt', rt_len=64, rt_every=1,\n\
      \                 facility_id=0, af='', ext_every=8,\n            \
      \     alert=0, alert_text='This is a test of the AM data alert flag. This is\
      \ only a test.',\n                 alert_file='', rt_program=''):\n        gr.sync_block.__init__(self,\
      \ name='PMDS Encoder',\n                               in_sig=[np.complex64],\
      \ out_sig=[np.complex64])\n        Encoder.__init__(self, samp_rate=samp_rate,\
      \ data_on=data_on, deviation=deviation,\n                         bit_rate=bit_rate,\
      \ fmt=fmt, call=call, pi=pi, pty=pty, tp=tp, ta=ta, ps=ps,\n               \
      \          ps_upper=ps_upper, ps_file=ps_file, rt=rt, rt_file=rt_file, rt_len=rt_len,\n\
      \                         rt_every=rt_every, facility_id=facility_id, af=af,\n\
      \                         ext_every=ext_every, alert=alert, alert_text=alert_text,\n\
      \                         alert_file=alert_file, rt_program=rt_program)\n\n\
      \    def work(self, input_items, output_items):\n        self.modulate(input_items[0],\
      \ output_items[0])\n        return len(input_items[0])\n"
    af: ''''''
    affinity: ''
    alert: alert_level
    alert_file: ''''''
    alert_text: alert_msg
    alias: ''
    bit_rate: data_rate
    call: '''WAMD'''
    comment: ''
    data_on: data_on if stereo == 0 else 0
    deviation: data_dev
    ext_every: '8'
    facility_id: '0'
    fmt: '''compact'''
    maxoutbuf: '0'
    minoutbuf: '0'
    pi: ''''''
    ps: ps_text
    ps_file: ''''''
    ps_upper: '1'
    pty: '5'
    rt: ''''''
    rt_every: '1'
    rt_file: ''''''
    rt_len: '64'
    rt_program: ''''''
    samp_rate: samp_rate
    ta: '0'
    tp: '0'
  states:
    _io_cache: '(''PMDS Encoder'', ''blk'', [(''samp_rate'', ''192000''), (''data_on'',
      ''1''), (''deviation'', ''8.6''), (''bit_rate'', ''93.75''), (''fmt'', "''compact''"),
