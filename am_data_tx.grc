options:
  parameters:
    author: Jordan Johnson (jowijo)
    catch_exceptions: 'True'
    category: CQ
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Mono AM with RDS-lite station data on the carrier phase, and an optional
      skywave channel simulator.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: am_data_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: PMDS Transmitter (Mono AM + PMDS + skywave simulator)
    window_size: 1500, 720
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1201, 8]
    rotation: 0
    state: enabled

